# Copy to .env.local for local development. Never commit real values.

# Claude API key. Used by the CV helper (/cv) and the task builder (/tasks/new/describe).
# Without it, development falls back to sample results; production CV reading returns an error.
ANTHROPIC_API_KEY=

# true = always return the sample CV instead of calling Claude (offline demos).
CV_PARSE_MOCK=

# true = allow the demo "acting as" user switcher in a production build.
# Set only on the demo deployment, and never with real user data.
DEMO_AUTH=
